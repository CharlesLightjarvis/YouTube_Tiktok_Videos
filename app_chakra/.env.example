# 🔧 Configuration API Laravel
# Copiez ce fichier en .env et remplacez les URLs par votre backend Laravel

# URL de votre API Laravel (sans slash à la fin)
LARAVEL_API_URL=http://localhost:8000

# URL de l'API utilisateurs (utilisera LARAVEL_API_URL par défaut si non défini)
USERS_API_URL=http://localhost:8000

# Token d'authentification pour les requêtes serveur (optionnel)
# LARAVEL_API_TOKEN=your-secret-token-here
